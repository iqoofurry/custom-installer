<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.iqoofurry.sheetinstaller"
    android:versionCode="5"
    android:versionName="1.3">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/ThemeCustomInstaller">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/ThemeCustomInstaller">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/ThemeCustomInstaller" />

        <activity
            android:name=".InstallSheetActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/ThemeCustomInstallerSheet">

            <intent-filter android:priority="500">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="application/vnd.android.package-archive"
                    android:pathPattern=".*\\.apk" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="application/vnd.android.package-archive"
                    android:pathPattern=".*\\.apk" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="application/vnd.android.package-archive"
                    android:pathPattern=".*apk" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="application/vnd.android.package-archive"
                    android:pathPattern=".*apk" />
            </intent-filter>

            <intent-filter android:priority="500">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.apk" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*apk" />
            </intent-filter>

            <intent-filter android:priority="500">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.xapk" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.xapk" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.apks" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.apks" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.apkm" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.apkm" />
            </intent-filter>

            <intent-filter android:priority="500">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="application/vnd.android.package-archive" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <provider
            android:name=".SelfApkProvider"
            android:authorities="com.iqoofurry.sheetinstaller.self"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
