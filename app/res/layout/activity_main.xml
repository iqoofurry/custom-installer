<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:id="@+id/hero_icon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_hero_icon_md3">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_install"
                    android:tint="@color/md_on_primary_container" />
            </FrameLayout>

            <TextView
                android:id="@+id/title_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearanceCIDisplay" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/app_subtitle_short"
                android:textAppearance="@style/TextAppearanceCIBody" />

            <TextView
                android:id="@+id/chip_mode"
                style="@style/WidgetCIChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/text_mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearanceCIBody" />

            <FrameLayout
                android:id="@+id/status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_md3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_title"
                        android:textAppearance="@style/TextAppearanceCITitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:id="@+id/text_status_mode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/label_root"
                            android:textAppearance="@style/TextAppearanceCIBody" />

                        <TextView
                            android:id="@+id/pill_mode"
                            style="@style/WidgetCIChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_android"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:id="@+id/text_status_change"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/label_install"
                            android:textAppearance="@style/TextAppearanceCIBody" />

                        <TextView
                            android:id="@+id/pill_priv"
                            style="@style/WidgetCIChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_package"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:id="@+id/text_status_targets"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/label_stock"
                            android:textAppearance="@style/TextAppearanceCIBody" />

                        <TextView
                            android:id="@+id/pill_stock"
                            style="@style/WidgetCIChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_status_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearanceCIBody"
                        android:textColor="@color/md_error"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <Button
                android:id="@+id/btn_choose"
                style="@style/WidgetCIButtonFilled"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/choose_apk" />

            <Button
                android:id="@+id/btn_check_root"
                style="@style/WidgetCIButtonTonal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/check_root" />

            <Button
                android:id="@+id/btn_remove_stock"
                style="@style/WidgetCIButtonText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:text="@string/remove_stock"
                android:textColor="@color/md_error" />

            <FrameLayout
                android:id="@+id/how_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_md3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/how_it_works"
                        android:textAppearance="@style/TextAppearanceCITitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/step_1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="1"
                            android:textAppearance="@style/TextAppearanceCILabel"
                            android:textColor="@color/md_on_primary_container" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/step_open"
                            android:textAppearance="@style/TextAppearanceCIBody"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/step_2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="2"
                            android:textAppearance="@style/TextAppearanceCILabel"
                            android:textColor="@color/md_on_primary_container" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/step_choose"
                            android:textAppearance="@style/TextAppearanceCIBody"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/step_3"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_step_number"
                            android:gravity="center"
                            android:text="3"
                            android:textAppearance="@style/TextAppearanceCILabel"
                            android:textColor="@color/md_on_primary_container" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/step_always"
                            android:textAppearance="@style/TextAppearanceCIBody"
                            android:textColor="@color/md_on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/footer_version"
                android:textAppearance="@style/TextAppearanceCILabel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/app_tagline"
                android:textAppearance="@style/TextAppearanceCILabel" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_chip_md3"
        android:clickable="true"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/md_on_surface_variant" />
</FrameLayout>
