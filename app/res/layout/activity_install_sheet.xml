<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FF000000"
        android:clickable="false"
        android:focusable="false" />

    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:outlineProvider="background"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_sheet_md3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/sheet_handle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginBottom="6dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:alpha="0.5"
                    android:background="@drawable/bg_handle" />
            </FrameLayout>

            <com.iqoofurry.sheetinstaller.MaxHeightScrollView
                android:id="@+id/scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/app_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_row_tonal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/app_icon_container"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_card_md3">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/app_icon"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null" />
                            </FrameLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/app_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearanceCITitle" />

                            <TextView
                                android:id="@+id/app_package"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearanceCIMono" />

                            <TextView
                                android:id="@+id/app_version"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearanceCILabel" />

                            <TextView
                                android:id="@+id/app_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:paddingStart="9dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="3dp"
                                android:textAppearance="@style/TextAppearanceCILabel"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/text_warning_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:visibility="gone"
                        android:background="@drawable/bg_warning_glass">

                        <TextView
                            android:id="@+id/text_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_warning"
                            android:drawablePadding="10dp"
                            android:drawableTint="@color/md_on_error_container"
                            android:padding="14dp"
                            android:textAppearance="@style/TextAppearanceCIBody"
                            android:textColor="@color/md_on_error_container" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/info_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_row_tonal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:id="@+id/row_size"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_storage"
                                    android:tint="@color/md_primary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="@string/label_size"
                                    android:textAppearance="@style/TextAppearanceCILabel" />

                                <TextView
                                    android:id="@+id/value_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearanceCIValue" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/row_obb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_package"
                                    android:tint="@color/md_primary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="@string/label_obb"
                                    android:textAppearance="@style/TextAppearanceCILabel" />

                                <TextView
                                    android:id="@+id/value_obb"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearanceCIValue" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/row_sdk"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_android"
                                    android:tint="@color/md_primary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="@string/label_sdk"
                                    android:textAppearance="@style/TextAppearanceCILabel" />

                                <TextView
                                    android:id="@+id/value_sdk"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearanceCIValue" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/row_signature"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_shield"
                                    android:tint="@color/md_primary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="@string/label_signature"
                                    android:textAppearance="@style/TextAppearanceCILabel" />

                                <TextView
                                    android:id="@+id/value_signature"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearanceCIValue" />
                            </LinearLayout>

                            <com.iqoofurry.sheetinstaller.FlowLayout
                                android:id="@+id/abi_chips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/label_bundle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/label_bundle"
                                android:textAppearance="@style/TextAppearanceCILabel"
                                android:visibility="gone" />

                            <com.iqoofurry.sheetinstaller.FlowLayout
                                android:id="@+id/bundle_chips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/perm_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_row_tonal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:id="@+id/perm_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/permissions"
                            android:textAppearance="@style/TextAppearanceCIValue" />

                        <TextView
                            android:id="@+id/perm_count"
                            style="@style/WidgetCIChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <ImageView
                            android:id="@+id/perm_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron"
                            android:tint="@color/md_on_surface_variant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/perm_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/perm_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permissions_empty"
                            android:textAppearance="@style/TextAppearanceCIBody"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.iqoofurry.sheetinstaller.MaxHeightScrollView>

            <FrameLayout
                android:id="@+id/progress_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:background="@drawable/bg_card_md3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:id="@+id/status_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearanceCITitle" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="14dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/md_primary"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_bar" />

                    <TextView
                        android:id="@+id/status_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearanceCIBody" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_cancel"
                    style="@style/WidgetCIButtonTonal"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/cancel" />

                <Button
                    android:id="@+id/btn_install"
                    style="@style/WidgetCIButtonFilled"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1.5"
                    android:text="@string/install" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>