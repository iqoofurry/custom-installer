<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeCustomInstaller">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeCustomInstallerSheet">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/AnimationCustomInstallerSheet</item>
        <item name="android:colorAccent">@color/md_primary</item>
    </style>

    <style name="AnimationCustomInstallerSheet">
        <item name="android:activityOpenEnterAnimation">@anim/no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/no_animation</item>
    </style>

    <style name="TextAppearanceCIDisplay">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearanceCIHeadline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearanceCITitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearanceCITitleSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearanceCIBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:lineSpacingMultiplier">1.18</item>
    </style>

    <style name="TextAppearanceCILabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <style name="TextAppearanceCIValue">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="TextAppearanceCIMono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <style name="WidgetCIButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@null</item>
    </style>

    <style name="WidgetCIButtonFilled">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_button_filled_md3</item>
        <item name="android:textColor">@color/md_on_primary</item>
    </style>

    <style name="WidgetCIButtonTonal">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_button_tonal_md3</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
    </style>

    <style name="WidgetCIButtonText">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <style name="WidgetCIChip">
        <item name="android:background">@drawable/bg_chip_md3</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WidgetCICard">
        <item name="android:background">@drawable/bg_card_md3</item>
    </style>
</resources>
